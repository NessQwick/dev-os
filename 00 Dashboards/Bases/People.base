# Dev OS: people as an editable table. Bases syntax is evolving; verify on your Obsidian version.
filters:
  and:
    - type == "person"
    - '!file.hasTag("example")'
properties:
  file.name:
    displayName: Person
  note.role:
    displayName: Role
  note.company:
    displayName: Company or team
  note.meets:
    displayName: Meets
  note.supervisor:
    displayName: Supervisor
views:
  - type: table
    name: People
    filters:
      and:
        - archived != true
    order:
      - file.name
      - role
      - company
      - supervisor
      - email
      - meets
    sort:
      - property: file.name
        direction: ASC
